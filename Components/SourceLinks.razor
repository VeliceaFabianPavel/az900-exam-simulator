@using MockExam.Fluent.Models
@* Links from a question into the training module that teaches it. *@

@if (Lessons.Count > 0)
{
    <div class="source-links">
        <span class="source-lbl">
            <AppIcon Name="book" Size="16" />
            <span>@T.ReadTheSource</span>
        </span>

        <span class="source-list">
            @foreach (var l in Lessons)
            {
                var lesson = l;
                var module = TrainingCatalog.ModuleOf(lesson);
                <button type="button" class="source-link"
                        title="@(module?.Title) &middot; @lesson.Pages"
                        @onclick="() => OnOpen.InvokeAsync(lesson)">
                    <span class="source-link-ttl">@lesson.Title</span>
                    <span class="source-link-pages">@lesson.Pages</span>
                </button>
            }
        </span>
    </div>
}

@code {
    [Parameter, EditorRequired] public Item Item { get; set; } = default!;

    /// <summary>Raised with the lesson the reader picked, so the host can open the dialog.</summary>
    [Parameter] public EventCallback<Lesson> OnOpen { get; set; }

    [Parameter] public Ui T { get; set; } = Ui.En;

    /// <summary>At most two, most relevant first, so the panel does not become a menu.</summary>
    private IReadOnlyList<Lesson> Lessons =>
        [.. TrainingCatalog.LessonsFor(Item).Take(2)];
}

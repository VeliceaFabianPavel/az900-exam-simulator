@using MockExam.Fluent.Models
@inject NavigationManager Nav
@* Pre-exam screen 0: choose a delivery mode, then one of the ten practice forms. *@

<div class="pre-card pick">
    <div class="pre-body">
        <h1 class="pre-ttl">Choose a practice exam</h1>
        <h2 class="pre-sub">Exam AZ-900: Microsoft Azure Fundamentals</h2>

        <p>
            Each form draws @ExamCatalog.QuestionCount questions from a bank of
            @QuestionBank.All.Count items, stratified to match the published skills
            outline. Questions and answer options are reshuffled on every attempt.
        </p>

        @* Reading route out of the exam flow, for people who want the material first. *@
        <button type="button" class="study-cta" @onclick="@(() => Nav.NavigateTo("study"))">
            <span class="study-cta-icon"><AppIcon Name="book" Size="20" /></span>
            <span class="study-cta-txt">
                <span class="study-cta-ttl">Not ready to sit one yet?</span>
                <span class="study-cta-sub">
                    Work through the study guide first &mdash;
                    @TrainingCatalog.AllLessons.Count lessons across
                    @TrainingCatalog.Modules.Count modules.
                </span>
            </span>
            <AppIcon Name="chevron-right" Size="18" />
        </button>

        @* ------------------------------------------------------ step 1: mode *@
        <h3 class="pick-step">Step 1 &middot; How do you want to sit it?</h3>

        <div class="mode-grid" role="radiogroup" aria-label="Delivery mode">
            @foreach (var m in ExamModeInfo.All)
            {
                var mode = m;
                var on = _mode == mode;
                <button type="button" role="radio" aria-checked="@(on ? "true" : "false")"
                        class="mode-tile @(on ? "selected" : "")"
                        @onclick="() => _mode = mode">
                    <span class="mode-head">
                        <span class="mode-icon">
                            <AppIcon Name="@(mode == ExamMode.Practice ? "bulb" : "timer")" Size="20" />
                        </span>
                        <span class="mode-titles">
                            <span class="mode-name">@mode.Name() mode</span>
                            <span class="mode-tag">@mode.Tagline()</span>
                        </span>
                        <span class="mode-check" aria-hidden="true">
                            @if (on)
                            {
                                <AppIcon Name="check" Size="14" />
                            }
                        </span>
                    </span>

                    @* Spans rather than a list: a button may only contain phrasing content. *@
                    <span class="mode-points">
                        @foreach (var point in mode.Points())
                        {
                            <span class="mode-point">@point</span>
                        }
                    </span>
                </button>
            }
        </div>

        @* ------------------------------------------------------ step 2: form *@
        <h3 class="pick-step">Step 2 &middot; Pick a form</h3>

        <ul class="pre-facts compact">
            <li>
                <AppIcon Name="@(_mode == ExamMode.Practice ? "infinity" : "timer")" Size="22" />
                <span>
                    Exam Time:
                    <b>@(_mode == ExamMode.Practice ? "No limit" : $"{ExamSession.DurationMinutes} minutes")</b>
                </span>
            </li>
            <li>
                <AppIcon Name="award" Size="22" />
                <span>Pass mark: <b>@ExamSession.PassMark</b> of 1000</span>
            </li>
            @foreach (var d in ExamDomainInfo.All)
            {
                <li>
                    <AppIcon Name="doc" Size="22" />
                    <span>@d.Name(): <b>@d.ItemsPerForm() questions</b> (@d.Weighting())</span>
                </li>
            }
        </ul>

        <div class="form-grid">
            @foreach (var f in ExamCatalog.Forms)
            {
                var form = f;
                <button type="button" class="form-tile @(_mode == ExamMode.Practice ? "practice" : "")"
                        @onclick="() => OnSelect.InvokeAsync(new ExamStart(form, _mode))">
                    <span class="form-no">@form.Number</span>
                    <span class="form-name">@form.Title</span>
                    <span class="form-meta">
                        @ExamCatalog.QuestionCount questions &middot;
                        @(_mode == ExamMode.Practice ? "untimed" : $"{ExamSession.DurationMinutes} min")
                    </span>
                    <span class="form-mode">@_mode.Name()</span>
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<ExamStart> OnSelect { get; set; }

    private ExamMode _mode = ExamMode.Practice;
}

<div class="rail-section @(Expanded && Open ? "open" : "")">
    <button type="button" class="rail-item" title="@Label" aria-label="@Label"
            aria-expanded="@(Expanded && Open)" @onclick="Toggle">
        <AppIcon Name="@Icon" />
        @if (Expanded)
        {
            <span class="rail-label">@Label</span>
            <span class="rail-caret">
                <AppIcon Name="@(Open ? "chevron-up" : "chevron-down")" Size="16" />
            </span>
        }
    </button>

    @if (Expanded && Open)
    {
        <div class="rail-panel">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task Toggle() => OpenChanged.InvokeAsync(!Open);
}

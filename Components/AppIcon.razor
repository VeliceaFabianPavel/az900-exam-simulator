@* Inline Fluent-style line icons. Keeps the icon set self-contained so the
   build does not depend on the generated icon assemblies. *@

<svg class="app-icon" width="@Size" height="@Size" viewBox="0 0 20 20" fill="none"
     stroke="currentColor" stroke-width="1.35" stroke-linecap="round"
     stroke-linejoin="round" aria-hidden="true" focusable="false">
    @((MarkupString)Path(Name))
</svg>


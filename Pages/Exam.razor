@page "/"
@using MockExam.Fluent.Models
@implements IDisposable
@inject ExamSession Session
@inject CourseState Courses
@inject TrainingProgress Training

<PageTitle>Practice Exam</PageTitle>

@if (Session.Screen is ExamScreen.Pick or ExamScreen.Agreement or ExamScreen.Summary or ExamScreen.Ready)
{
    @* ------------------------------------------------ pre-exam screens *@
    <div class="pre-shell">
        <header class="pre-header">
            <span class="brand-logo">
                <img src="images/logo.jpg" alt="Infinity Atom" />
            </span>

            @if (Session.Screen != ExamScreen.Pick)
            {
                <div class="pre-time">
                    <div class="hdr-block-top">
                        <span class="hdr-legend">@(Session.IsPractice ? T.TimeElapsed : T.TimeRemaining)</span>
                        <FluentSwitch @bind-Value="_showTime" aria-label="Show the clock" />
                    </div>
                    @if (_showTime)
                    {
                        <span class="exam-clock @ClockClass">@Clock</span>
                    }
                </div>
            }
        </header>

        <main class="pre-main">
            @if (Session.Screen == ExamScreen.Pick && !Courses.Chosen)
            {
                <CoursePicker OnSelect="PickCourse" />
            }
            else if (Session.Screen == ExamScreen.Pick)
            {
                <ExamPicker Course="Courses.Current" OnSelect="StartExam"
                            OnChangeCourse="() => Courses.Clear()" />
            }
            else if (Session.Screen == ExamScreen.Agreement)
            {
                <AgreementView OnAccept="Session.Next" OnDecline="() => _declined = true" />
            }
            else
            {
                <SummaryView Session="Session" Ready="@(Session.Screen == ExamScreen.Ready)" />
            }
        </main>

        <footer class="pre-footer">
            @if (Session.Screen is ExamScreen.Summary or ExamScreen.Ready)
            {
                <button type="button" class="pre-btn wide" @onclick="Session.Next">
                    <span>@(Session.Screen == ExamScreen.Ready ? T.StartExam : T.Next)</span>
                    <AppIcon Name="chevron-right" Size="16" />
                </button>
            }

            <button type="button" class="scheme-btn" @onclick="() => _schemeOpen = !_schemeOpen">
                <AppIcon Name="sun" Size="16" />
                <span>Color Scheme</span>
                <AppIcon Name="@(_schemeOpen ? "chevron-up" : "chevron-down")" Size="16" />
            </button>

            @if (_schemeOpen)
            {
                <div class="scheme-flyout">
                    @foreach (var m in Modes)
                    {
                        var mode = m;
                        <button type="button" class="rail-choice @(Layout?.Mode == mode.Value ? "selected" : "")"
                                @onclick="() => SetMode(mode.Value)">
                            @mode.Label
                        </button>
                    }
                </div>
            }
        </footer>
    </div>
}
else
{
    @* ---------------------------------------------------- exam delivery *@
    <div class="exam-shell">

        <ExamToolbar Session="Session"
                     Expanded="_railExpanded"
                     ExpandedChanged="OnRailExpandedChanged"
                     Open="_navOpen"
                     Active="@_overlay"
                     OnCommand="OnCommand"
                     Mode="@(Layout?.Mode ?? DesignThemeModes.System)"
                     ModeChanged="SetMode" />

        @* Tap-anywhere-to-close backdrop. Present only while the phone drawer is open. *@
        @if (_navOpen)
        {
            <button type="button" class="nav-scrim" aria-label="Close the exam toolbar"
                    @onclick="() => _navOpen = false"></button>
        }

        <header class="exam-header">
            <button type="button" class="hdr-menu" aria-label="Open the exam toolbar"
                    aria-expanded="@(_navOpen ? "true" : "false")"
                    @onclick="() => _navOpen = !_navOpen">
                <AppIcon Name="menu" Size="20" />
            </button>

            <div class="hdr-title">
                <span class="q-no">
                    @HeaderTitle
                    @if (Session.IsPractice)
                    {
                        <span class="mode-badge" title="Untimed practice with hints and answers">
                            <AppIcon Name="bulb" Size="12" />
                            <span>@T.PracticeModeName</span>
                        </span>
                    }
                </span>
                <span class="q-sub">@HeaderSubtitle</span>
            </div>

            <div class="hdr-block">
                <div class="hdr-block-top">
                    <span class="hdr-legend">Progress</span>
                    <FluentSwitch @bind-Value="_showProgress" aria-label="Show progress" />
                </div>
                @if (_showProgress)
                {
                    <div class="progress-groups">
                        @foreach (var g in Session.Progress())
                        {
                            <div class="progress-group @(g.Stub ? "stub" : "") @(g.Label == CurrentSection ? "current" : "")">
                                <span class="progress-lbl">@GroupLabel(g)</span>
                                <div class="progress-track">
                                    <span style="width:@Percent(g)%"></span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="hdr-block right">
                <div class="hdr-block-top">
                    <span class="hdr-legend">@(Session.IsPractice ? T.TimeElapsed : T.TimeRemaining)</span>
                    <FluentSwitch @bind-Value="_showTime" aria-label="Show the clock" />
                </div>
                @if (_showTime)
                {
                    <span class="exam-clock @ClockClass">@Clock</span>
                }
            </div>

            @* Phone-only: the progress groups above are too wide, so show one thin bar. *@
            <div class="hdr-thin" aria-hidden="true">
                <span style="@ThinProgress"></span>
            </div>
        </header>

        <main class="exam-main">
            <div class="exam-card">
                @if (Session.Screen == ExamScreen.Review)
                {
                    <ReviewView Session="Session" />
                }
                else if (Session.Screen == ExamScreen.Score)
                {
                    <ScoreView Session="Session" OnRestart="Session.Restart" OnReview="Session.ShowReport" />
                }
                else if (Session.Screen == ExamScreen.Report)
                {
                    <ReportView Session="Session" OnRestart="Session.Restart" OnBack="Session.ShowScore" />
                }
                else if (Session.Screen == ExamScreen.Feedback)
                {
                    <FeedbackView Item="Session.Current.Item"
                                  Response="Session.CurrentState.Response"
                                  Number="@(Session.Current.Seq ?? 0)"
                                  Answered="@Session.IsComplete(Session.Current)"
                                  NextLabel="@NextLabel"
                                  T="T"
                                  OnBack="Session.Previous"
                                  OnOpenLesson="OpenLesson" />
                }
                else
                {
                    <ItemBody Item="Session.Current.Item"
                              Response="Session.CurrentState.Response"
                              T="T"
                              ResponseChanged="SaveResponse" />

                    @if (Session.IsPractice && Session.Current.Item.Scored)
                    {
                        <AssistPanel Item="Session.Current.Item"
                                     State="Session.CurrentState"
                                     T="T"
                                     OnToggleHint="ToggleHint"
                                     OnToggleHelp="ToggleHelp"
                                     OnOpenLesson="OpenLesson" />
                    }
                }
            </div>
        </main>

        <footer class="exam-footer @(_moreOpen ? "more-open" : "")">

            @* Order is set in CSS: one row on desktop, stacked rows on a phone. *@
            @if (Session.Screen == ExamScreen.Item && Session.Current.Item.Scored)
            {
                <div class="footer-secondary">
                    <FluentButton Appearance="Appearance.Stealth"
                                  Disabled="@Session.CurrentState.Response.IsEmpty"
                                  OnClick="ResetAnswer">
                        <AppIcon Name="reset" Size="16" />
                        <span style="margin-left:6px">@T.ResetAnswer</span>
                    </FluentButton>

                    <FluentCheckbox Value="@Session.CurrentState.Marked"
                                    ValueChanged="ToggleMark" Label="@T.ReviewLater" />

                    <FluentCheckbox Value="@Session.CurrentState.Feedback"
                                    ValueChanged="ToggleFeedback" Label="@T.LeaveFeedback" />
                </div>
            }

            @if (Session.IsPractice && Session.Screen == ExamScreen.Item && Session.Current.Item.Scored)
            {
                <div class="footer-assist">
                    <FluentButton Appearance="Appearance.Neutral" OnClick="ToggleHint">
                        <AppIcon Name="bulb" Size="16" />
                        <span style="margin-left:6px">@(Session.CurrentState.HintOpen ? T.HideHint : T.Hint)</span>
                    </FluentButton>

                    <FluentButton Appearance="Appearance.Neutral" OnClick="ToggleHelp">
                        <AppIcon Name="@(Session.CurrentState.HelpOpen ? "eye-off" : "eye")" Size="16" />
                        <span style="margin-left:6px">@(Session.CurrentState.HelpOpen ? T.HideAnswer : T.ShowAnswer)</span>
                    </FluentButton>
                </div>
            }

            <div class="footer-primary">
                <FluentButton Appearance="Appearance.Neutral"
                              Disabled="@(!Session.CanGoPrevious)"
                              OnClick="Session.Previous">
                    <AppIcon Name="chevron-left" Size="16" />
                    <span style="margin-left:6px">@T.Previous</span>
                </FluentButton>

                <FluentButton Appearance="Appearance.Accent"
                              Disabled="@(Session.Screen is ExamScreen.Score or ExamScreen.Report)"
                              OnClick="OnNext">
                    <span style="margin-right:6px">@NextLabel</span>
                    <AppIcon Name="chevron-right" Size="16" />
                </FluentButton>

                @* Appears once the review panel has been opened, so jumping to a question
                   from there is not a one-way trip. *@
                @if (Session.CanReturnToReview)
                {
                    <FluentButton Appearance="Appearance.Neutral" Class="footer-review"
                                  Title="Back to the review panel"
                                  OnClick="Session.ShowReview">
                        <AppIcon Name="list" Size="16" />
                        <span class="btn-label" style="margin-left:6px">@T.BackToReview</span>
                    </FluentButton>
                }

                <span class="spacer"></span>

                @* Phone-only: reveals the secondary row, which is collapsed by default. *@
                @if (Session.Screen == ExamScreen.Item && Session.Current.Item.Scored)
                {
                    <button type="button" class="footer-more"
                            aria-label="More question options"
                            aria-expanded="@(_moreOpen ? "true" : "false")"
                            @onclick="() => _moreOpen = !_moreOpen">
                        <AppIcon Name="@(_moreOpen ? "chevron-down" : "chevron-up")" Size="18" />
                    </button>
                }
            </div>
        </footer>
    </div>
}

@* ------------------------------------------------------------ overlays *@

<LessonDialog Lesson="_lesson" Item="_lessonItem" OnClose="CloseLesson" />

<FluentDialog Hidden="@(_overlay != "calculator")" Modal="false" TrapFocus="false">
    <FluentDialogHeader>Calculator</FluentDialogHeader>
    <FluentDialogBody><CalculatorPanel /></FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Neutral" OnClick="CloseOverlay">Close</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<FluentDialog Hidden="@(_overlay != "break")" Modal="true">
    <FluentDialogHeader>Take a break</FluentDialogHeader>
    <FluentDialogBody>
        <p>The exam clock keeps running during an unscheduled break.</p>
        <p>You have <strong>@Clock</strong> remaining.</p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="CloseOverlay">Resume exam</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<FluentDialog Hidden="@(_overlay != "help")" Modal="true">
    <FluentDialogHeader>Help</FluentDialogHeader>
    <FluentDialogBody>
        <p>Use <strong>Next</strong> and <strong>Previous</strong> to move through the form.</p>
        <p>Select <strong>Review later</strong> to flag a question, then open
           <strong>Exam Progress</strong> in the toolbar to track your position.</p>
        <p>You can change any answer at any time before you end the exam.</p>

        @if (Session.IsPractice)
        {
            <p>
                You are in <strong>Practice mode</strong>. There is no time limit and the
                clock counts up, so nothing ends the attempt but you.
            </p>
            <p>
                <strong>Hint</strong> gives you a nudge towards the idea a question turns on.
                <strong>Show answer</strong> reveals the key and the full explanation. Both
                are available on every question, and the score report notes where you used them.
            </p>
        }
        else
        {
            <p>
                You are in <strong>Exam mode</strong>. The clock counts down from
                @ExamSession.DurationMinutes minutes and the exam ends by itself when it
                reaches zero. Hints and answers are not available until you end the exam.
            </p>
        }
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="CloseOverlay">Close</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<FluentDialog Hidden="@(!_confirmEnd)" Modal="true">
    <FluentDialogHeader>@(Session.IsPractice ? "Finish this practice set?" : "End the exam?")</FluentDialogHeader>
    <FluentDialogBody>
        <p>You have answered @Session.AnsweredCount of @Session.TotalQuestions questions.</p>
        @if (Session.IsPractice && Session.HelpedCount > 0)
        {
            <p>You revealed the answer on @Session.HelpedCount of them; those are still scored as you answered them.</p>
        }
        <p>You cannot return to the questions after this point.</p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Neutral" OnClick="() => _confirmEnd = false">Cancel</FluentButton>
        <FluentButton Appearance="Appearance.Accent" OnClick="ConfirmEnd">
            @(Session.IsPractice ? "Finish" : "End exam")
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<FluentDialog Hidden="@(!_declined)" Modal="true">
    <FluentDialogHeader>Agreement required</FluentDialogHeader>
    <FluentDialogBody>
        <p>You must accept the Candidate Agreement before the exam can begin.</p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="() => _declined = false">Back</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    private bool _railExpanded = true;
    private bool _navOpen;        // phone drawer
    private Lesson? _lesson;      // training lesson shown over the question
    private Item? _lessonItem;    // the question the reader opened it from
    private bool _moreOpen;       // phone secondary action row
    private bool _confirmEnd;
    private bool _declined;
    private bool _schemeOpen;
    private bool _showProgress = true;
    private bool _showTime = true;
    private string? _overlay;
    private Timer? _timer;

    [CascadingParameter] private MainLayout? Layout { get; set; }

    /// <summary>Strings for the language of the course being delivered.</summary>
    private Ui T => Ui.For(Session.Course.Language);

    private static readonly (string Label, DesignThemeModes Value)[] Modes =
    [
        ("System", DesignThemeModes.System),
        ("Light", DesignThemeModes.Light),
        ("Dark", DesignThemeModes.Dark)
    ];

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            if (Session.Started && !Session.Ended)
            {
                Session.Tick();
            }
            StateHasChanged();
        }), null, 1000, 1000);
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        _timer?.Dispose();
    }

    private void OnCommand(string command)
    {
        _overlay = _overlay == command ? null : command;
        _navOpen = false;   // a command opens a dialog, so get the drawer out of the way
    }

    /// <summary>
    /// The rail's own collapse button serves both layouts: it narrows the sidebar on a
    /// desktop and closes the drawer on a phone.
    /// </summary>
    private void OnRailExpandedChanged(bool expanded)
    {
        _railExpanded = expanded;
        if (!expanded)
        {
            _navOpen = false;
        }
    }

    /// <summary>Width of the thin phone progress bar, as answered over total.</summary>
    private string ThinProgress
    {
        get
        {
            var total = Session.TotalQuestions;
            var pct = total == 0 ? 0 : 100 * Session.AnsweredCount / total;
            return FormattableString.Invariant($"width:{pct}%");
        }
    }

    private void CloseOverlay() => _overlay = null;

    private void SetMode(DesignThemeModes mode)
    {
        if (Layout is null)
        {
            return;
        }

        Layout.Mode = mode;
        Layout.Refresh();
        _schemeOpen = false;
    }

    private void PickCourse(Course course)
    {
        Courses.Select(course);
        Training.UseCourse(course);
    }

    private void StartExam(ExamStart start) =>
        Session.SelectForm(Courses.Current, start.Form, start.Mode);

    private Task SaveResponse(Response response)
    {
        Session.SetResponse(Session.Current.Key, response);
        return Task.CompletedTask;
    }

    private void ResetAnswer() => Session.ResetResponse(Session.Current.Key);

    private void ToggleMark(bool _) => Session.ToggleMark(Session.Current.Key);

    private void ToggleFeedback(bool _) => Session.ToggleFeedback(Session.Current.Key);

    private void OpenLesson(Lesson lesson)
    {
        _lesson = lesson;
        _lessonItem = Session.Current.Item;
    }

    private void CloseLesson()
    {
        _lesson = null;
        _lessonItem = null;
    }

    private void ToggleHint() => Session.ToggleHint(Session.Current.Key);

    private void ToggleHelp() => Session.ToggleHelp(Session.Current.Key);

    private static string GroupLabel(ProgressGroup g) =>
        g.Stub ? g.Label : $"{g.Label} ({g.Answered}/{g.Total})";

    private static int Percent(ProgressGroup g) => g.Total == 0 ? 0 : 100 * g.Answered / g.Total;

    private string CurrentSection => Session.Screen == ExamScreen.Item ? Session.Current.Section : "";

    private string HeaderTitle => Session.Screen switch
    {
        ExamScreen.Feedback => $"{T.Question} {Session.Current.Seq} · {T.Result}",
        ExamScreen.Review => T.Review,
        ExamScreen.Score => T.ScoreReport,
        ExamScreen.Report => T.AnswerReview,
        _ => Session.Current.Seq is int s ? $"{T.Question} {s}" : "Introduction"
    };

    private string HeaderSubtitle => Session.Screen switch
    {
        ExamScreen.Review => $"{Session.AnsweredCount} of {Session.TotalQuestions} answered",
        ExamScreen.Score => Session.Form.Title,
        ExamScreen.Report => $"{Session.CorrectCount} of {Session.TotalQuestions} correct",
        _ => $"{Session.Form.Title} \u00b7 {Session.Current.Item.Domain.ShortName()}"
    };

    private string NextLabel => Session.Screen switch
    {
        ExamScreen.Review => Session.IsPractice ? T.FinishAndScore : T.EndExam,
        ExamScreen.Feedback => Session.Index >= Session.Pages.Count - 1
            ? T.Review
            : T.NextQuestion,
        _ => Session.Index >= Session.Pages.Count - 1 ? T.Review : T.Next
    };

    /// <summary>Counts down in Exam mode and up in Practice mode.</summary>
    private string Clock
    {
        get
        {
            var t = Session.Clock;
            return $"{(int)t.TotalMinutes:00} : {t.Seconds:00}";
        }
    }

    private string ClockClass => Session.ClockIsLow ? "low" : Session.IsPractice ? "up" : "";

    private void OnNext()
    {
        if (Session.Screen == ExamScreen.Review)
        {
            _confirmEnd = true;
            return;
        }
        Session.Next();
    }

    private void ConfirmEnd()
    {
        _confirmEnd = false;
        Session.EndExam();
    }
}
